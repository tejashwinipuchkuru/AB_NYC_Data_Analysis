 value=""/><column index="2" value=""/></display_formats><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">SELECT * FROM AB_NYC_2024 LIMIT 10;

</sql><sql name="SQL 2*">SELECT COUNT(*) AS total_listings FROM AB_NYC_2024;</sql><sql name="SQL 3*">SELECT field5, COUNT(*) AS total_listings FROM AB_NYC_2024 GROUP BY field5 ORDER BY total_listings DESC;</sql><sql name="SQL 4*">SELECT field10, AVG(field11) AS avg_price FROM AB_NYC_2024 GROUP BY field10 ORDER BY avg_price DESC;</sql><sql name="SQL 5*">SELECT MAX(field11) AS lowest_price FROM AB_NYC_2024;</sql><sql name="SQL 6*">SELECT MIN(field11) AS lowest_price FROM AB_NYC_2024;</sql><sql name="SQL 7*">SELECT AVG(field12) AS avg_minimum_nights FROM AB_NYC_2024;

</sql><sql name="SQL 8*">SELECT field4, COUNT(*) AS listings FROM AB_NYC_2024 GROUP BY field4 ORDER BY listings DESC LIMIT 10;</sql><sql name="SQL 9*">SELECT field2, field1 FROM AB_NYC_2024 WHERE field11&gt; (SELECT AVG(field11) FROM AB_NYC_2024);</sql><sql name="SQL 10*">SELECT A.field4, COUNT(B.field1) AS listings FROM AB_NYC_2024 A JOIN AB_NYC_2024 B ON A.field3= B.field3 GROUP BY A.field4 HAVING COUNT(A.field1)&gt;1 ORDER BY listings DESC;

</sql><current_tab id="9"/></tab_sql></sqlb_project>
